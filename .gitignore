venv/
.envrc

# UV / Poetry / Pip
.uv/
uv.lock.bak
pip-wheel-metadata/
.site-packages/

# Backend app specific
backend/.env
backend/logs/
backend/.pytest_cache/
backend/.mypy_cache/
backend/models/
backend/models.zip
backend/.ruff_cache/
