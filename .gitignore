# OS / Editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.iml

# Root general
.env
.env.*
!.env.example
*.log
logs/
*.tmp
*.temp
*.lock

# Python (backend)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.coverage
coverage.xml
htmlcov/
.tox/
